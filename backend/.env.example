OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: Gemini nodes error out until this is set
GOOGLE_API_KEY=
# Default for agents without their own model (provider inferred from the id)
DEFAULT_MODEL=claude-haiku-5-5
# Used when a node picks OpenAI but no specific model
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Spend safety (keep these low while testing)
MAX_COMPLETION_TOKENS=600
MAX_PROMPT_CHARS=12000
MAX_SYSTEM_CHARS=3000
MAX_CHAIN_STEPS=6
# Default spend cap for one end-to-end run (the box on the end-to-end page)
RUN_BUDGET_USD=1.00
DAILY_BUDGET_USD=1.00
MAX_RUNS_PER_DAY=25
MIN_SECONDS_BETWEEN_RUNS=8
REQUIRE_CONFIRM=true

# Multi-agent pipeline limits (per run)
MAX_LLM_CALLS_PER_RUN=24
MAX_RUN_COST_USD=0.25
MAX_TOOL_STEPS=6
MAX_EVAL_ROUNDS=3
# Claude 5.x thinks by default; thinking counts toward this output cap
ANTHROPIC_MAX_TOKENS=4000

# tau-bench retail, both generations (official tau_bench and tau2 packages).
# The simulated customer and tau2's judge run through litellm with the keys above;
# any model from the price table works (claude-*, gpt-*, gemini-*).
TAU_USER_MODEL=claude-haiku-5-5
TAU_JUDGE_MODEL=claude-haiku-5-5
TAU_MAX_STEPS=60
# tau2 data (python scripts/download_datasets.py --only tau2 puts it under backend/data)
# TAU2_DATA_DIR=

# Finance Agent Benchmark v2.1 (FAB)
# Judges for the rubric (comma-separated; majority vote per criterion). The official jury is
# three frontier models, so any setting here approximates it.
FAB_JUDGE_MODELS=claude-haiku-5-5
FAB_RETRIEVAL_MODEL=claude-haiku-5-5
FAB_MAX_TOOL_STEPS=16
# Per-question cost cap for FAB runs (other benchmarks use MAX_RUN_COST_USD)
FAB_MAX_RUN_COST_USD=0.30
# SEC EDGAR asks for an identifying User-Agent: "Organisation contact@domain"
SEC_USER_AGENT=AgentEvaluation research-harness admin@example.org
# Optional official tools: web_search (Tavily) and price_history (Tiingo)
TAVILY_API_KEY=
TIINGO_API_KEY=

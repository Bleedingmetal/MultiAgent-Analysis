OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: Gemini nodes error out until this is set
GOOGLE_API_KEY=
# Default for agents without their own model (provider inferred from the id)
DEFAULT_MODEL=claude-haiku-5-5
# Used when a node picks OpenAI but no specific model
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Spend safety (keep these low while testing)
MAX_COMPLETION_TOKENS=600
MAX_PROMPT_CHARS=6000
MAX_SYSTEM_CHARS=3000
MAX_CHAIN_STEPS=6
DAILY_BUDGET_USD=1.00
MAX_RUNS_PER_DAY=25
MIN_SECONDS_BETWEEN_RUNS=8
REQUIRE_CONFIRM=true

# Multi-agent pipeline limits (per run)
MAX_LLM_CALLS_PER_RUN=24
MAX_RUN_COST_USD=0.25
MAX_TOOL_STEPS=6
MAX_EVAL_ROUNDS=3
# Claude 5.x thinks by default; thinking counts toward this output cap
ANTHROPIC_MAX_TOKENS=4000

# tau-bench retail, both generations (official tau_bench and tau2 packages).
# The simulated customer and tau2's judge run through litellm with the keys above.
TAU_USER_MODEL=gpt-4o-mini
TAU_JUDGE_MODEL=gpt-4o-mini
TAU_MAX_STEPS=60
# tau2 data (python scripts/download_datasets.py --only tau2 puts it under backend/data)
# TAU2_DATA_DIR=
